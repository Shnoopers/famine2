[sub_resource type="GDScript" id="GDScript_jg5c2"]
script/source = "extends Control

@onready var notscript = get_node(\"/root/variables\")

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass


func _on_start_pressed() -> void:
	get_tree().change_scene_to_file(\"res://gameplay.tscn\")
	


func _on_night_1_pressed() -> void:
	notscript.set_night(1)
	get_tree().change_scene_to_file(\"res://gameplay.tscn\")


func _on_night_2_pressed() -> void:
	notscript.set_night(2)
	get_tree().change_scene_to_file(\"res://gameplay.tscn\")


func _on_night_3_pressed() -> void:
	notscript.set_night(3)
	get_tree().change_scene_to_file(\"res://gameplay.tscn\")


func _on_night_4_pressed() -> void:
	notscript.set_night(4)
	get_tree().change_scene_to_file(\"res://gameplay.tscn\")


func _on_night_5_pressed() -> void:
	notscript.set_night(5)
	get_tree().change_scene_to_file(\"res://gameplay.tscn\")
"

